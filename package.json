{
  "name": "pos-modern",
  "productName": "POS Modern",
  "version": "1.0.1",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer.ps1 -PackageOnly",
    "make": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer.ps1",
    "publish": "electron-forge publish",
    "build": "vite build",
    "test": "npm --prefix server test && node --test tests/licensing.test.mjs",
    "test:licensing": "node --test tests/licensing.test.mjs",
    "lint": "node scripts/check-sources.js",
    "i18n:check": "node scripts/audit-translations.js --check && node scripts/audit-server-errors.js --check"
  },
  "keywords": [],
  "author": {
    "name": "SatY213",
    "email": "abdelhakim_merini@outlook.fr"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "44.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
